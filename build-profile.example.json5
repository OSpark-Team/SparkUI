{
  app: {
    signingConfigs: [], // filled in by DevEco Studio (File > Project Structure > Signing Configs); keep it out of git
    products: [
      {
        name: 'default',
        targetSdkVersion: '26.0.0',
        compatibleSdkVersion: '6.0.2(22)',
        runtimeOS: 'HarmonyOS',
        buildOption: {
          strictMode: {
            caseSensitiveCheck: true,
            useNormalizedOHMUrl: true,
          },
        },
      },
    ],
    buildModeSet: [
      {
        name: 'debug',
      },
      {
        name: 'release',
      },
    ],
  },
  modules: [
    {
      name: 'gallery',
      srcPath: './gallery',
      targets: [
        {
          name: 'default',
          applyToProducts: [
            'default',
          ],
        },
      ],
    },
    {
      name: 'library',
      srcPath: './library',
    },
  ],
}