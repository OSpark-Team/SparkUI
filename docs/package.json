{
  "name": "sparkui-docs",
  "private": true,
  "type": "module",
  "description": "SparkUI documentation site (VitePress) with an approximate ArkTS-to-web previewer.",
  "scripts": {
    "docs:gen": "node scripts/generate.mjs",
    "docs:dev": "npm run docs:gen && vitepress dev .",
    "docs:build": "npm run docs:gen && vitepress build .",
    "docs:preview": "vitepress preview .",
    "test:previewer": "node scripts/test-previewer.mjs"
  },
  "devDependencies": {
    "vitepress": "^1.6.4",
    "vue": "^3.5.13"
  }
}
